<Project>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OptimizationPreference>Size</OptimizationPreference>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- 让 .editorconfig 里的代码风格规则（IDE0007 var 等）在构建时生效 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- PublishAotCross: 用 xwin SDK store + lld-link + Zig 完成链接，无需 VS C++ 工具链。
         Zig / lld / xwin 版本与 AotPreferCustom 都由包内 ToolsetsVersion.props 提供默认值，
         这里不用重复声明（要固定版本再显式写 ZigVersion 等）。 -->
    <NoWarn>$(NoWarn);LNK4099</NoWarn>
    <!-- 许可证元数据：AGPL-3.0-or-later，全文见仓库根目录 LICENSE -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- 全球化策略：默认用不变模式（不需要 ICU，也不依赖系统 libicu）。
       SqlServer 因 SqlClient 不支持不变模式，在自己的 csproj 里覆盖为 false，
       并只在 linux RID 引用 Icu4C.Runtime（Windows 走系统 NLS）。 -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 交叉编译 AOT 的工具链（lld / Zig / xwin）。只在 AOT 发布链路里生效，
       普通类库（Connector.Core）引用它是空操作。 -->
  <ItemGroup>
    <PackageReference Include="PublishAotCross.Tools" PrivateAssets="all" />
  </ItemGroup>

</Project>
